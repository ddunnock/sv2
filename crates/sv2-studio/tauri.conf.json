{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sv2 Studio",
  "identifier": "org.sv2.studio",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [{ "label": "main", "title": "sv2 Studio", "width": 1440, "height": 900 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
