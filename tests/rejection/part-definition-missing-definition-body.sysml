// Rule: a PartDefinition ends in a DefinitionBody, ';' or a braced body.
// SysML 8.2.2.11  — PartDefinition = OccurrenceDefinitionPrefix 'part' 'def' Definition
// SysML 8.2.2.6.1 — Definition = DefinitionDeclaration DefinitionBody
// SysML 8.2.2.6.1 — DefinitionBody = ';' | '{' DefinitionBodyItem* '}'
part def Vehicle
