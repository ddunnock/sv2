/target
**/*.rs.bk
*.pending-snap

# uv creates one here if anyone runs `uv venv`; .python-version decides which
# interpreter it gets. Nothing in the gate uses it — the scripts run under the
# system python3.11 directly.
.venv/

# Tool caches for the Python scripts.
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Personal, per-machine Claude Code configuration. The shared config in
# `.claude/` IS committed on purpose – hooks, rules, agents, and skills are
# team artifacts.
CLAUDE.local.md
.claude/settings.local.json
.claude/gate-off

# Derivation units. Each carries its clause verbatim as `spec_clause_text`, 1.2 MB
# of OMG specification prose across the set, and this repository is MIT and public.
# Same constraint that keeps the wikis out (state.json, "wiki-reproducibility").
# Rebuild them:
#   python3.11 .claude/scripts/export_wiki_clauses.py
#   export SV2_WIKI_CLAUSES=~/.sv2-derivation/bnf-clauses.json
#   python3.11 .claude/scripts/grammar_plan.py
# Derived rules do NOT survive a fresh clone this way — see the pending decision
# "derivation-evidence-in-repo".
.claude/state/grammar/units/
