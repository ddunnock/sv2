/target
**/*.rs.bk
*.pending-snap

# `uv sync` builds it from pyproject's dev group; .python-version decides which
# interpreter it gets. The gate uses it for the test tooling only (pytest, and
# jsonschema for the state schema) and runs every check script under the system
# python3.12 directly — STD-001-PY §3.1.
.venv/

# Tool caches for the Python scripts.
__pycache__/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Personal, per-machine Claude Code configuration. The shared config in
# `.claude/` IS committed on purpose – hooks, rules, agents, and skills are
# team artifacts.
CLAUDE.local.md
.claude/settings.local.json
.claude/gate-off

# The derivation units ARE committed: they carry the derived rule, the decision and
# the evidence, and none of them carries the clause text. See NOTICE.md.
# The clause export they are derived from is not, and lives outside the tree:
#   python3.12 .claude/scripts/export_wiki_clauses.py
#   export SV2_WIKI_CLAUSES=~/.sv2-derivation/bnf-clauses.json

# JetBrains IDE workspace, per-machine.
.idea/

# Bun/TypeScript build inputs and outputs under app/. bun.lock IS committed —
# it plus bunfig's install settings are the reproducibility story, and a
# committed node_modules would put platform binaries in the history.
node_modules/
dist/

# CodeGraph's index, a per-machine derived cache: a 514K binary rebuilt by
# `codegraph init`, holding nothing the tree does not already hold.
.codegraph/
